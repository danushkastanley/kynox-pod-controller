# Controller Configuration
PORT=50051
HTTP_PORT=8080
NODE_NAME=
POD_NAME=
LOG_LEVEL=info
MTLS_ENABLED=true

# Generate a strong random value and provide it through a secret in production.
CLASSIFIER_ADMIN_TOKEN=

# Alert Configuration
# Slack Integration
SLACK_WEBHOOK_URL=
SLACK_CHANNEL="#security-alerts"

# Generic Webhook Integration
ALERT_WEBHOOK_URL=

# Alert Filtering
# Comma-separated list of event types to alert on (leave empty for all)
# Example: EXEC,CONNECT,SETUID
ALERT_EVENT_TYPES=

# Minimum alert level to trigger notifications (INFO, WARNING, CRITICAL)
ALERT_MIN_LEVEL=WARNING

# Alert Rate Limiting
# Maximum number of alerts per minute (0 for no limit)
ALERT_RATE_LIMIT=10
