# Controller Configuration
PORT=50051
NODE_NAME=local
POD_NAME=controller-1
LOG_LEVEL=debug

# Alert Configuration
# Slack Integration (get from https://api.slack.com/apps)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#security-alerts

# Generic Webhook Integration
ALERT_WEBHOOK_URL=

# Alert Filtering
ALERT_EVENT_TYPES=
ALERT_MIN_LEVEL=WARNING
ALERT_RATE_LIMIT=10
