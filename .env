# Controller Configuration
PORT=50051
NODE_NAME=local
POD_NAME=controller-1
LOG_LEVEL=debug

# Alert Configuration
# Slack Integration (get from https://api.slack.com/apps)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/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
SLACK_CHANNEL=#alerts

# Generic Webhook Integration
ALERT_WEBHOOK_URL=

#Classifier type yaml or cve
CLASSIFIER_TYPE=yaml

# Alert Filtering
ALERT_EVENT_TYPES=CHMOD,SETUID,PTRACE,MOUNT,EXEC
ALERT_MIN_LEVEL=HIGH
ALERT_RATE_LIMIT=30
DEBUG=debug pod-controller
