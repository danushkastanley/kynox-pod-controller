# Controller Configuration
PORT=50051
NODE_NAME=local
POD_NAME=controller-1
LOG_LEVEL=debug

# Alert Configuration
# Slack Integration (get from https://api.slack.com/apps)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/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
SLACK_CHANNEL=#security-alerts

# Generic Webhook Integration
ALERT_WEBHOOK_URL=

# Alert Filtering
ALERT_EVENT_TYPES=SETUID,PTRACE,BPF_PROG,MOUNT,SECCOMP
ALERT_MIN_LEVEL=HIGH
ALERT_RATE_LIMIT=30
DEBUG=debug pod-controller
